+/// Get the ID of the single-extension `KVM_REG_RISCV_ISA_EXT` register for `index`.
+pub fn isa_ext_reg_id(index: u64) -> u64 {
+    KVM_REG_RISCV as u64
+        | KVM_REG_SIZE_U64
+        | u64::from(KVM_REG_RISCV_ISA_EXT)
+        | u64::from(KVM_REG_RISCV_ISA_SINGLE)
+        | index
+}
